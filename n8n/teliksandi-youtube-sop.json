        "url": "https://beglzlljgbcpmfktuvbs.supabase.co/rest/v1/rpc/teliksandi_terima_paket",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "sb_publishable__2ADgDgCMCyf_9Ux_U97Ng_S7OBp6SO" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
