            { "id": "u", "name": "upload", "value": "={{ ($json.body && $json.body.upload) || (/terbaru|baru|latest/i.test(($json.body && $json.body.topik) || '') ? 'minggu' : 'bulan') }}", "type": "string" },
            { "id": "d", "name": "jumlah", "value": "={{ ($json.body && $json.body.jumlah) || 2 }}", "type": "number" }
          ]
        },
        "options": {}
      },
      "id": "b1",
      "name": "B · Koordinator: tetapkan topik & aturan",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 300]
    },
    {
      "parameters": {
        "url": "https://youtube-transcript-woad-nine.vercel.app/api/teliksandi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
