      "maxTries": 2,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "fieldToSplitOut": "paket",
        "include": "selectedOtherFields",
        "fieldsToInclude": "perintah",
        "options": {}
      },
      "id": "d1",
      "name": "Pecah per video",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [660, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "combinator": "and",
          "conditions": [
            { "id": "k1", "leftValue": "={{ $json.konteks_jelas }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true", "singleValue": true } }
          ]
        },
        "options": {}
      },
      "id": "k1",
      "name": "J–K · Konteks sudah jelas?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [880, 300]
    },
    {
      "parameters": {
        "jsCode": "// M–N · Lihat pelan: tiap bagian yang gambarnya belum tepat diberi link ke detiknya\n// dan diserahkan ke Hermes/Claude Pekerja untuk ditonton & di-screenshot ulang.\n// Tidak menebak: kalau masih belum jelas, ditandai (P).\nreturn $input.all().map(i => {\n  const p = i.json;\n  const tugas = (p.perlu_lihat_pelan || []).map(x => `${x.waktu} → ${x.link} (${x.alasan})`);\n  return { json: { ...p,\n    tindak_lanjut: tugas.length ? 'LIHAT_PELAN' : 'TANDAI_KURANG',\n    tugas_lihat_pelan: tugas,\n    status: p.transkrip ? 'PERLU_LIHAT_PELAN' : 'KURANG_BAHAN',\n    catatan_konteks: (p.catatan_konteks || '') + ' | Bagian belum dipahami ditandai, tidak ditebak.'\n  } };\n});"
      },
      "id": "m1",
      "name": "M–P · Lihat pelan / tandai yang belum jelas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 420]
    },
    {
      "parameters": {
        "jsCode": "// L · Kumpulkan paket bahan (format serah-terima wajib)\nreturn $input.all().map(i => {\n  const p = i.json;\n  return { json: {\n    perintah: p.perintah,\n    link: p.link, judul: p.judul, kanal: p.kanal,\n    tanggal_unggah: p.tanggal_unggah_perkiraan || p.tanggal_unggah_teks,\n    transkrip: p.transkrip,\n    bagian_terpilih: p.bagian_terpilih,\n    screenshot: (p.bagian_terpilih || []).map(b => ({ waktu: b.screenshot && b.screenshot.waktu, src: b.screenshot && b.screenshot.src, tepat: b.screenshot && b.screenshot.tepat })),\n    catatan_konteks: p.catatan_konteks,\n    status: p.status, kekurangan: p.kekurangan || [], tugas_lihat_pelan: p.tugas_lihat_pelan || []\n  } };\n});"
      },
      "id": "l1",
      "name": "L · Kumpulkan paket bahan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, 300]
    },
